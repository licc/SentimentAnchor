# HTTP 服务
HOST=127.0.0.1
PORT=8787

# 行情轮询间隔，最低 5000ms；默认 10000ms（10s）
REFRESH_MS=10000

# ---- 安全（可选，但对外部署强烈建议）----
# 设置后 API 需要访问口令，前端会显示登录页
# APP_TOKEN=change-me-to-a-long-random-token
# 仅当需要允许跨域前端时配置；同源部署留空
# CORS_ORIGINS=https://your-domain.example

# ---- AI 研判（可选）----
# 不配置时：使用本地量化规则引擎，页面显示“本地量化推理”
# 配置后：页面“LLM 深度研判”按钮启用，调用 OpenAI 兼容的 /chat/completions
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 也支持直接使用以下任一变量（二选一即可）：
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=


# ---- 券商 / T+0 交易接口 ----
# Windows 券商适配器地址；需自行部署，Key 可留空
ETF_BROKER_URL=http://127.0.0.1:8888
# ETF_BROKER_KEY=
# 实盘单笔金额上限（元）
ETF_MAX_ORDER_AMOUNT=50000
# 佣金费率（万2=0.0002）与最低佣金；ETF 无印花税
ETF_COMMISSION_RATE=0.0002
ETF_MIN_COMMISSION=5
# 估算滑点（bps）与单日手续费上限（占总资产 %）
ETF_SLIPPAGE_BPS=5
ETF_MAX_DAILY_FEE_PCT=0.3
# 下单后回读委托的次数和间隔；超时未成交会撤单并暂停
ETF_ORDER_TIMEOUT_MS=20000
ETF_ORDER_VERIFY_ATTEMPTS=6
ETF_ORDER_VERIFY_DELAY_MS=2000
