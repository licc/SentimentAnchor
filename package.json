{
  "name": "sentiment-anchor",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --ignore \"thsapi/**\" --ignore \".venv/**\" --ignore \"data/**\" --ignore \"logs/**\" server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test:dynamic": "node --import tsx scripts/dynamic-anchors.mjs",
    "test:ai": "node --import tsx scripts/ai-mock-test.mjs",
    "test:dark": "node scripts/dark-theme-test.mjs",
    "test:core": "node --import tsx scripts/core-tests.mjs",
    "test:state": "node --import tsx scripts/order-state-machine-test.mjs",
    "test:broker": "node --import tsx scripts/broker-mock-test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:licc/SentimentAnchor.git"
  }
}
